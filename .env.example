# Both the CLI and web startup load mafia2/.env. Shell variables take precedence.
ANTHROPIC_API_KEY=

# Opt in after adding your project's keys and selecting its actual region.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# EU: https://cloud.langfuse.com ; self-hosted: your deployment URL
LANGFUSE_TRACING_ENVIRONMENT=development
